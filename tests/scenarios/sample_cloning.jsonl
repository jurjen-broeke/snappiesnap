# The sample constructs, and the cloning experiment the app's "Try it with the sample
# constructs" button sets up. Everything here is generated by SnappieSnap, so a user with no
# files of their own - every user of the web version, on their first visit - can run a cloning
# experiment through to a product.
{"command": "sample_open", "params": {"which": "cloning"}, "expect": [{"path": "/opened/0", "eq": "pSample"}, {"path": "/opened/1", "eq": "demoInsert"}, {"path": "/documents", "len": 2}]}
{"note": "the plasmid keeps its 3200 bp: the polylinker is written over a free stretch", "command": "switch_document", "params": {"index": 0}}
{"command": "sequence_info", "expect": [{"path": "/length", "eq": 3200}, {"path": "/weight/circular", "eq": true}]}
{"note": "six enzymes of the polylinker cut it exactly once", "command": "enzyme_sites", "params": {"enzymes": ["EcoRI", "BamHI", "SalI", "XhoI", "NotI", "PstI"]}, "expect": [{"path": "/enzymes/0/sites", "len": 1}, {"path": "/enzymes/1/sites", "len": 1}, {"path": "/enzymes/2/sites", "len": 1}, {"path": "/enzymes/3/sites", "len": 1}, {"path": "/enzymes/4/sites", "len": 1}, {"path": "/enzymes/5/sites", "len": 1}]}
{"command": "switch_document", "params": {"index": 1}}
{"command": "sequence_info", "expect": [{"path": "/length", "eq": 762}, {"path": "/weight/circular", "eq": false}]}
{"note": "the clone the button sets up: one orientation fits, giving one product", "command": "restriction_clone", "params": {"vector_document": 1, "insert_document": 2, "vector_enzymes": ["EcoRI", "BamHI"], "preview": true}, "expect": [{"path": "/constructs", "len": 1}, {"path": "/constructs/0/length", "eq": 3950}]}
{"command": "restriction_clone", "params": {"vector_document": 1, "insert_document": 2, "vector_enzymes": ["EcoRI", "BamHI"]}}
{"command": "sequence_info", "expect": {"path": "/length", "eq": 3950}}
{"command": "history_tree", "expect": [{"path": "/steps/operation", "eq": "Restriction cloning"}]}
{"note": "the plasmid alone is the default sample, and it is not treated as unsaved work", "command": "sample_open", "params": {"discard_changes": true}, "expect": {"path": "/opened/0", "eq": "pSample"}}
{"command": "documents", "expect": {"path": "/documents/3/dirty", "eq": false}}
