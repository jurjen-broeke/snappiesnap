# Diagnostic digest (synthetic): the clone has a 700 bp insert with a BamHI site between the vector's EcoRI and HindIII sites.
{"command": "new", "params": {"name": "vector", "topology": "circular", "residues": ""}}
{"command": "new", "params": {"name": "clone", "topology": "circular", "residues": ""}}
{"note": "HindIII linearises both: 2,400 against 3,100 bp, far enough apart", "command": "diagnostic_digest", "params": {"documents": [1, 2], "enzymes": ["BamHI", "HindIII"], "max_enzymes": 1}, "expect": [{"path": "/suggestions", "len": 1}, {"path": "/suggestions/0/enzymes", "eq": ["HindIII"]}, {"path": "/suggestions/0/lanes/0/fragments", "eq": [2400]}, {"path": "/suggestions/0/lanes/1/fragments", "eq": [3100]}]}
{"note": "BamHI leaves the vector uncut: not a diagnostic digest", "command": "diagnostic_digest", "params": {"documents": [1, 2], "enzymes": ["BamHI"]}, "expect": {"path": "/suggestions", "len": 0}}
{"note": "the same construct named twice counts once", "command": "diagnostic_digest", "params": {"documents": [1, 1]}, "expect": {"path": "/constructs", "eq": 1}}
{"note": "an enzyme set is what the lab holds: BamHI doesn't cut the vector, so HindIII alone is the only runnable digest", "command": "enzyme_set_create", "params": {"name": "Fridge", "enzymes": ["HindIII", "BamHI", "NotAnEnzymeI"]}}
{"command": "diagnostic_digest", "params": {"documents": [1, 2], "set": "Fridge", "max_enzymes": 1}, "expect": [{"path": "/set", "eq": "Fridge"}, {"path": "/in_stock_searched", "eq": 2}, {"path": "/missing_from_database", "eq": ["NotAnEnzymeI"]}, {"path": "/suggestions", "len": 1}, {"path": "/suggestions/0/enzymes", "eq": ["HindIII"]}, {"path": "/suggestions/0/in_stock", "eq": true}]}
{"note": "widened on request: far more enzymes are searched than the fridge holds, and the best digest here is still one it can run (BamHI + HindIII are both in it). Ordering and marking of out-of-stock digests are pinned in crates/engine/tests/commands.rs", "command": "diagnostic_digest", "params": {"documents": [1, 2], "set": "Fridge", "include_out_of_stock": true, "limit": 20}, "expect": [{"path": "/suggestions/0/enzymes", "eq": ["BamHI", "HindIII"]}, {"path": "/suggestions/0/in_stock", "eq": true}, {"path": "/in_stock_searched", "eq": 2}]}
{"note": "a set that isn't there is an error, not a silent search of everything", "command": "diagnostic_digest", "params": {"documents": [1, 2], "set": "no such set"}, "expect_error": "not_found"}
