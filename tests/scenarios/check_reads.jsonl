# Check a construct with a sequencing read (synthetic .ab1): the read is trimmed, placed on the construct, and the stretch it doesn't cover is reported.
{"command": "new", "params": {"name": "pTemplate", "residues": "GATTACAGATTACACCGTTGCATGCAAGCTTGGCACTGGCCGTCGTTTTACAACGTCGTGACTGGGAAAACCCTGGCG", "topology": "circular"}}
{"command": "check_reads", "params": {"files": ["../../tests/scenarios/data/read1.ab1"]}, "expect": [{"path": "/placed", "eq": 1}, {"path": "/reads/0/kept", "eq": [4, 44]}, {"path": "/reads/0/strand", "eq": "forward"}, {"path": "/reads/0/start", "eq": 0}, {"path": "/reads/0/end", "eq": 40}, {"path": "/uncovered/0/start", "eq": 40}, {"path": "/findings", "len": 0}]}
{"note": "without trimming, the read's poor ends don't fit the construct well enough", "command": "check_reads", "params": {"files": ["../../tests/scenarios/data/read1.ab1"], "trim": false}, "expect": {"path": "/reads/0/kept", "eq": null}}
{"note": "rows lays the read out against the construct, one character per construct position from its start, so several reads line up in one grid", "command": "check_reads", "params": {"files": ["../../tests/scenarios/data/read1.ab1"], "rows": true}, "expect": [{"path": "/reads/0/row", "eq": "GATTACAGATTACACCGTTGCATGCAAGCTTGGCACTGGC"}, {"path": "/reads/0/row_quality/0", "eq": 38}, {"path": "/reads/0/row_quality", "len": 40}]}
{"note": "row_positions gives the untrimmed read's base behind each column, so a trace can be drawn under the columns: the read was trimmed to 4..44, so column 0 is read base 4", "command": "check_reads", "params": {"files": ["../../tests/scenarios/data/read1.ab1"], "rows": true}, "expect": [{"path": "/reads/0/row_positions/0", "eq": 4}, {"path": "/reads/0/row_positions/39", "eq": 43}, {"path": "/reads/0/row_positions", "len": 40}]}
