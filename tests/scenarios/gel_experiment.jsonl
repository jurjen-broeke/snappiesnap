# A gel experiment across two synthetic constructs: one lane per construct, each with its own method.
{"command": "new", "params": {"name": "pA", "residues": "AAAAAAAAAAAAAAAAAAAAGAATTCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCGAATTCAAAAAAAAAAAAAAAAAAAA", "topology": "circular"}}
{"command": "new", "params": {"name": "pB", "residues": "ACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCA", "topology": "linear"}}
{"note": "the ladder, then the constructs in order; lane 4 has no method yet", "command": "gel_experiment", "params": {"ladder": "100 bp", "agarose": 2.0, "lanes": [{"document": 1, "method": {"kind": "digest", "enzymes": ["EcoRI"]}}, {"document": 2, "method": {"kind": "uncut"}}, {"document": 1}]}, "expect": [{"path": "/lanes", "len": 4}, {"path": "/lanes/0/title", "eq": "100 bp"}, {"path": "/lanes/1/title", "eq": "pA: EcoRI"}, {"path": "/lanes/1/document", "eq": 1}, {"path": "/lanes/2/title", "eq": "pB: Uncut"}, {"path": "/lanes/2/bands/0/bp", "eq": 80}, {"path": "/lanes/3/bands", "len": 0}]}
{"note": "a lane whose method can't run reports why; the others still run", "command": "gel_experiment", "params": {"lanes": [{"document": 2, "method": {"kind": "pcr", "forward": "missing", "reverse": "missing"}}, {"document": 1, "method": {"kind": "uncut"}}]}, "expect": [{"path": "/lanes/1/error", "contains": "missing"}, {"path": "/lanes/2/bands", "len": 1}]}
