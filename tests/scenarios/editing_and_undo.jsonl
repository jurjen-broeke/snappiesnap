# Basic editing: every edit is undoable and redoable, and failed edits change nothing.
{"command": "new", "params": {"name": "pEdit", "residues": "AAAACCCCGGGGTTTT"}, "expect": {"path": "/length", "eq": 16}}
{"command": "insert", "params": {"at": 4, "residues": "tt"}, "expect": {"path": "/length", "eq": 18}}
{"command": "get_residues", "params": {"range": {"start": 2, "end": 8}}, "expect": {"path": "/residues", "eq": "AAttCC"}}
{"command": "delete", "params": {"range": {"start": 0, "end": 4}}, "expect": {"path": "/length", "eq": 14}}
{"command": "replace", "params": {"range": {"start": 0, "end": 2}, "residues": "GAATTC"}, "expect": {"path": "/length", "eq": 18}}
{"note": "a failed edit changes nothing", "command": "replace", "params": {"range": {"start": 0, "end": 2}, "residues": "GAXTTC"}, "expect_error": "invalid_input"}
{"method": "doc.get", "expect": [{"path": "/molecule/length", "eq": 18}, {"path": "/dirty", "eq": true}, {"path": "/can_undo", "eq": true}]}
{"command": "undo", "expect": {"path": "/length", "eq": 14}}
{"command": "undo", "expect": {"path": "/length", "eq": 18}}
{"command": "undo", "expect": {"path": "/length", "eq": 16}}
{"command": "undo", "expect_error": "not_enabled"}
{"command": "redo", "expect": {"path": "/length", "eq": 18}}
{"command": "get_residues", "params": {"range": {"start": 0, "end": 18}}, "expect": {"path": "/residues", "eq": "AAAAttCCCCGGGGTTTT"}}
{"note": "a new edit clears redo", "command": "reverse_complement"}
{"command": "redo", "expect_error": "not_enabled"}
{"command": "get_residues", "params": {"range": {"start": 0, "end": 6}}, "expect": {"path": "/residues", "eq": "AAAACC"}}
