# The Gateway att sites are built in: an entry clone (attL1 - insert - attL2) built from
# the sites themselves, detected with no feature library of the user's own.
{"command": "new", "params": {"name": "pENTR-synthetic", "residues": "", "topology": "circular"}}
{"note": "attL1 and attL2 found exactly, in order, with no library of one's own", "command": "detect_features", "params": {"own": false, "downloaded": false}, "expect": [{"path": "/features", "len": 2}, {"path": "/features/0/name", "eq": "attL1"}, {"path": "/features/0/range/start", "eq": 20}, {"path": "/features/0/range/end", "eq": 120}, {"path": "/features/0/strand", "eq": "forward"}, {"path": "/features/0/mismatches", "eq": 0}, {"path": "/features/1/name", "eq": "attL2"}, {"path": "/features/1/range/start", "eq": 180}, {"path": "/features/1/range/end", "eq": 280}]}
{"command": "add_detected_features", "params": {"own": false, "downloaded": false}, "expect": {"path": "/added", "eq": 2}}
